# GoldSweep secrets and machine settings. Copy this file to ".env" and fill it in.
# .env is git-ignored: never commit it. Blank values count as "not set".

# PAPER (default) never sends orders. LIVE also needs "mode: LIVE" in
# config.yaml and a typed confirmation at startup.
MODE=PAPER

# MetaTrader 5: use a DEMO account. Leave login, password and server blank to
# use the account the MT5 terminal is already logged in to.
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
MT5_PATH=C:\Program Files\MetaTrader 5\terminal64.exe

# News + AI (Phase 4). LLM_PROVIDER: anthropic (Claude, paid), groq (free plan at
# console.groq.com), or openai_compatible (LLM_BASE_URL + LLM_API_KEY, e.g. Gemini,
# OpenRouter or a local Ollama). LLM_MODEL empty = the provider's default model.
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
GROQ_API_KEY=
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
FINNHUB_API_KEY=
# FinanceCalendar.com economic calendar (free developer key, approved within 48 h).
# Without it the public Forex Factory weekly feed is used.
FINANCECALENDAR_API_KEY=
FRED_API_KEY=

# Alerts (Phase 5)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
